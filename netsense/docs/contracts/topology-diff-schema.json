{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.netsense.example/schemas/topology-diff-1.0.0.json",
  "title": "NetSense Topology Diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "diffId", "tenantId", "siteId", "baseSnapshotId",
    "sequence", "producedAt", "operations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "diffId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "siteId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "baseSnapshotId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sequence": { "type": "integer", "minimum": 1 },
    "producedAt": { "type": "string", "format": "date-time" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "entityKind": {
      "enum": ["site", "location", "zone", "subnet", "vlan", "device", "service", "application", "workload", "process", "capability", "user_group", "aggregate", "unknown"]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "entity"],
          "properties": {
            "op": { "const": "entity_added" },
            "entity": {
              "type": "object",
              "additionalProperties": true,
              "required": ["id", "kind"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "kind": { "$ref": "#/$defs/entityKind" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "entityId"],
          "properties": {
            "op": { "const": "entity_removed" },
            "entityId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "entityId", "assessment"],
          "properties": {
            "op": { "const": "assessment_changed" },
            "entityId": { "type": "string", "minLength": 1 },
            "assessment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operationalHealth": { "enum": ["healthy", "degraded", "unreachable", "unknown"] },
                "freshness": { "enum": ["current", "stale", "expired", "never_observed"] },
                "coverage": { "enum": ["full", "partial", "none", "unsupported"] },
                "managementState": { "enum": ["managed", "passive_only", "excluded", "maintenance"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "minProperties": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "relationship"],
          "properties": {
            "op": { "const": "relationship_added" },
            "relationship": {
              "type": "object",
              "additionalProperties": true,
              "required": ["id", "relationshipType", "source", "target"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "relationshipType": { "type": "string", "minLength": 1 },
                "source": { "type": "object" },
                "target": { "type": "object" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "relationshipId"],
          "properties": {
            "op": { "const": "relationship_removed" },
            "relationshipId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "entityId", "parentId"],
          "properties": {
            "op": { "const": "entity_reparented" },
            "entityId": { "type": "string", "minLength": 1 },
            "parentId": { "type": ["string", "null"] }
          }
        }
      ]
    }
  }
}
